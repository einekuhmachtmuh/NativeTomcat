<project name="NativeTomcat" default="java-compile" basedir=".">

	<!--
		The upstream Tomcat Ant build remains the authoritative build for
		Tomcat itself. This top-level file provides NativeTomcat's minimal
		Java smoke-build target and explicit delegation gates to the pinned
		upstream Tomcat build. It must not replace upstream build.xml.
	-->
	<property name="java.home" value="${java.home}" />
	<property environment="env" />
	<property name="java.source" value="17" />
	<property name="java.target" value="17" />
	<property name="native.java.classes" value="${basedir}/output/native-java/classes" />
	<property name="native.build.dir" value="${basedir}/output/native" />
	<property name="native.executable" value="${native.build.dir}/nativetomcat" />
	<property name="native.compiler" value="gcc" />
	<property name="tomcat.source.dir" value="${basedir}/upstream/tomcat" />
	<property name="tomcat.build.file" value="${tomcat.source.dir}/build.xml" />
	<property name="tomcat.expected.commit" value="cbe6e15ee81e2fc6232954292a80cca5d1e84009" />

	<path id="native.java.sources">
		<pathelement location="${basedir}/java" />
	</path>

	<target name="init">
		<mkdir dir="${native.java.classes}" />
	</target>

	<target name="java-compile" depends="tomcat-compile,init" description="Compile NativeTomcat Java bootstrap classes against the pinned Tomcat classes">
		<javac srcdir="${basedir}/java"
			destdir="${native.java.classes}"
			release="${java.source}"
			includeantruntime="false"
			debug="true"
			encoding="UTF-8">
			<classpath>
				<pathelement location="${tomcat.source.dir}/output/classes" />
			</classpath>
		</javac>
	</target>

	<target name="verify-tomcat-source" description="Verify the initialized Tomcat submodule is pinned to the expected commit">
		<available file="${tomcat.build.file}" property="tomcat.build.available" />
		<fail unless="tomcat.build.available" message="upstream/tomcat/build.xml is missing; initialize the pinned Tomcat submodule before invoking the upstream Ant build." />
		<exec executable="git" dir="${tomcat.source.dir}" outputproperty="tomcat.actual.commit" failifexecutionfails="true" failonerror="true">
			<arg value="rev-parse" />
			<arg value="HEAD" />
		</exec>
		<condition property="tomcat.commit.verified">
			<matches string="${tomcat.actual.commit}" pattern="^${tomcat.expected.commit}\s*$" />
		</condition>
		<fail unless="tomcat.commit.verified" message="Tomcat submodule commit mismatch: expected ${tomcat.expected.commit}, actual ${tomcat.actual.commit}. Refusing to invoke the upstream Ant build." />
	</target>

	<target name="tomcat-compile" depends="verify-tomcat-source" description="Run the pinned upstream Tomcat compile target through its own Ant build">
		<ant antfile="${tomcat.build.file}" dir="${tomcat.source.dir}" target="compile" inheritAll="false" inheritRefs="false" />
	</target>

	<target name="native-java-compile" depends="tomcat-compile,init" description="Compile NativeTomcat Java against the pinned Tomcat classes">
		<javac srcdir="${basedir}/java"
			destdir="${native.java.classes}"
			release="${java.source}"
			includeantruntime="false"
			debug="true"
			encoding="UTF-8">
			<classpath>
				<pathelement location="${tomcat.source.dir}/output/classes" />
			</classpath>
		</javac>
	</target>

	<target name="tomcat-deploy" depends="verify-tomcat-source" description="Run the pinned upstream Tomcat deploy target to build a working Tomcat instance">
		<ant antfile="${tomcat.build.file}" dir="${tomcat.source.dir}" target="deploy" inheritAll="false" inheritRefs="false" />
	</target>

	<target name="native-runtime-prepare" depends="tomcat-deploy,native-java-compile" description="Build the pinned Tomcat runtime and NativeTomcat Java bridge">
	</target>

	<target name="native-compile" depends="init" description="Compile the existing Linux native sources into the NativeTomcat executable">
		<mkdir dir="${native.build.dir}" />
		<exec executable="${native.compiler}" failifexecutionfails="true" failonerror="true">
			<arg value="-std=gnu11" />
			<arg value="-D_GNU_SOURCE" />
			<arg value="-Wall" />
			<arg value="-Wextra" />
			<arg value="-Wpedantic" />
			<arg value="-I${basedir}/native/include" />
			<arg value="-I${env.JAVA_HOME}/include" />
			<arg value="-I${env.JAVA_HOME}/include/linux" />
			<arg value="-pthread" />
			<arg value="-o" />
			<arg value="${native.executable}" />
			<arg value="${basedir}/native/src/main.c" />
			<arg value="${basedir}/native/src/nt_jvm.c" />
			<arg value="${basedir}/native/src/nt_runtime.c" />
			<arg value="${basedir}/native/src/nt_connection.c" />
			<arg value="-ldl" />
		</exec>
	</target>

	<target name="clean">
		<delete dir="${basedir}/output/native-java" />
		<delete dir="${native.build.dir}" />
	</target>

</project>
